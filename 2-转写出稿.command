#!/bin/zsh
# 第二步：后台转写 + 出稿。启动后可直接关窗口，不用守着。
cd "$(dirname "$0")"
LOG="$(pwd)/step2.log"
MAXMIN=40

# 防止重复启动
if pgrep -f "run_step2.sh" > /dev/null 2>&1; then
  echo "⚠️  已经有一个转写任务在后台跑了，不用重复启动。"
  echo ""
  echo "查看进度：tail -f \"$LOG\""
  echo ""
  read -r "?按回车关闭... "
  exit 0
fi

echo "════════════════════════════════════════════════════"
echo "  第 2 步：语音转文字 + 生成文案库（后台运行）"
echo "════════════════════════════════════════════════════"
echo "已在后台启动，接下来全自动，你可以直接关掉这个窗口。"
echo ""
echo "自动处理规则："
echo "  · 已转过的视频      → 跳过，不重复"
echo "  · 作品已失效/被删除 → 自动剔除，不再重试"
echo "  · 超过 ${MAXMIN} 分钟的超长视频 → 自动跳过"
echo "  · 中断了再双击本文件 → 从断点接着跑"
echo ""
echo "日志文件：step2.log"
echo "════════════════════════════════════════════════════"

: > "$LOG"
MAXMIN=$MAXMIN nohup ./run_step2.sh >> "$LOG" 2>&1 &
disown

sleep 3
echo ""
echo "▼ 实时进度（关掉窗口不影响后台运行，Ctrl+C 也只是停止查看）"
echo "────────────────────────────────────────────────────"
tail -f "$LOG"
